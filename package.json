{
  "name": "astria",
  "productName": "Astria",
  "version": "0.8.8",
  "description": "Frame-accurate desktop video review player for VFX artists",
  "main": "electron/main.cjs",
  "author": "Astria",
  "license": "UNLICENSED",
  "private": true,
  "config": {
    "forge": "./forge.config.cjs"
  },
  "scripts": {
    "start": "electron-forge start",
    "smoke": "electron . --smoke-test",
    "check:playback": "node scripts/playback-features-smoke.cjs",
    "check:startup": "node scripts/media-first-frame-test.cjs && electron scripts/startup-smoke.cjs",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "make:forge": "electron-forge make --platform=win32",
    "make:win": "electron-builder --config electron-builder.config.cjs --win nsis zip --x64",
    "check": "node --check scope-gpu.js && node --check player-features.js && node --check resource-browser.js && node --check electron/video-browser.cjs && node --check app.js && node --check electron/main.cjs && node --check electron/preload.cjs && node --check playback-adapter.js && node --check electron/media-catalog.cjs && node --check electron/media-service.cjs",
    "native:build": "node scripts/native-build.cjs",
    "check:formats": "node scripts/format-smoke.cjs",
    "check:browser": "electron scripts/browser-smoke.cjs"
  },
  "dependencies": {
    "electron-squirrel-startup": "^1.0.1"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.8.1",
    "@electron-forge/maker-squirrel": "^7.8.1",
    "@electron-forge/maker-zip": "^7.8.1",
    "electron": "40.10.5",
    "electron-builder": "^26.15.3",
    "node-addon-api": "8.5.0",
    "node-gyp": "11.5.0"
  },
  "build": {
    "appId": "com.astria.player",
    "productName": "Astria",
    "asar": true,
    "directories": {
      "output": "out/builder",
      "buildResources": "build"
    },
    "files": [
      "app.js",
      "resource-browser.js",
      "player-features.js",
      "scope-gpu.js",
      "index.html",
      "styles.css",
      "electron/**/*",
      "assets/**/*",
      "package.json",
      "!out/**/*",
      "media-formats.js",
      "playback-adapter.js",
      "THIRD_PARTY_NOTICES.md",
      "scripts/desktop-smoke.cjs",
      "scripts/release-ui-smoke.cjs",
      "scripts/sequence-smoke.cjs"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis",
        "zip"
      ],
      "artifactName": "Astria-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "shortcutName": "Astria",
      "runAfterFinish": true,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "include": "build/installer.nsh",
      "artifactName": "Astria-Setup-${version}.${ext}"
    }
  }
}
